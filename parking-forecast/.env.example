# Port nginx exposes the legacy result.json on
NGINX_PORT=8080

LOG_LEVEL=DEBUG

# Open Data Hub time series API ("ninja") — occupancy history. Publishing
# forecasts back to ODH/BDP isn't implemented yet (planned for later); predict
# only writes result.json for now.
TS_API_BASE_URL=https://mobility.api.opendatahub.testingmachine.eu/v2
TS_API_REFERER=el-parking-forecast
ODH_TOKEN_URL=https://auth.opendatahub.testingmachine.eu/auth/realms/noi/protocol/openid-connect/token
ODH_CLIENT_ID=odh-mobility-elaborations
ODH_CLIENT_SECRET=
STATION_TYPES=ParkingStation,ParkingSensor

# Tourism Open Data Hub API — weather + school/public holiday events
TOURISM_API_BASE_URL=https://tourism.api.testingmachine.eu/v1

# Model / feature engineering (defaults shown; see src/util/settings.py for
# the full list)
FOREST_TREES=60
MIN_TRAIN_ROWS=500
HOURS_TO_PREDICT=48

# How much raw occupancy history to keep before ingest purges it — bounds
# cache size and nightly training cost regardless of how long this runs.
OCCUPANCY_RETENTION_DAYS=400
